# ============================================
# KODE CLUB BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port (default: 5000)
PORT=5000

# Environment: development, production, test
NODE_ENV=development

# Backend URL (used for OAuth callbacks)
# Development: http://localhost:5000
# Production: https://api.yourdomain.com
BACKEND_URL=http://localhost:5000

# Frontend URL (for CORS and OAuth redirects)
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/kode-club
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/kode-club?retryWrites=true&w=majority
# Make sure to replace username, password, and cluster details
MONGODB_URI=mongodb://localhost:27017/kode-club

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret Key (REQUIRED - Generate a strong random string)
# Use: openssl rand -base64 32 or any secure random string generator
# IMPORTANT: Use a different secret for production!
# Generated secure secret (32 bytes, base64 encoded):
JWT_SECRET=3fa2t7jvTjRzgIEtywlpX/+J2J9NMkiOx7CfOafrfVE=

# JWT Token Expiration (optional, default: 7d)
# Format: 1h, 24h, 7d, 30d, etc.
JWT_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================

# Google OAuth 2.0 Client ID
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================
# Uncomment and configure if you want to send emails

# Email service provider (nodemailer compatible)
# Options: gmail, sendgrid, mailgun, smtp
# EMAIL_SERVICE=gmail

# SMTP Host (if using custom SMTP)
# EMAIL_HOST=smtp.gmail.com

# SMTP Port (if using custom SMTP)
# EMAIL_PORT=587

# Email username/address
# EMAIL_USER=your-email@gmail.com

# Email password or app password
# EMAIL_PASS=your-app-password

# Email sender name
# EMAIL_FROM_NAME=Kode Club

# ============================================
# OPTIONAL: RATE LIMITING
# ============================================

# Rate limit window in milliseconds (default: 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Max requests per window (default: 100)
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# OPTIONAL: LOGGING
# ============================================

# Log level: error, warn, info, debug (default: info)
# LOG_LEVEL=info

# Enable request logging (default: true in development)
# ENABLE_REQUEST_LOGGING=true

# ============================================
# OPTIONAL: FILE UPLOAD
# ============================================

# Maximum file upload size in bytes (default: 5MB)
# MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Generate strong secrets for production
# 3. Use environment-specific values
# 4. Keep secrets secure and rotate them regularly
# 5. For production, use a secrets management service
